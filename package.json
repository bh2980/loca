{
  "name": "translation-workbench",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @tw/server --filter @tw/web dev",
    "build": "pnpm --filter @tw/web build",
    "start": "pnpm --filter @tw/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "budget": "tsx scripts/budget.ts",
    "verify": "pnpm -r exec tsc --noEmit -p . && pnpm ui-rules && vitest run && pnpm budget",
    "db:generate": "pnpm --filter @tw/server db:generate",
    "samples": "tsx scripts/make-samples.ts",
    "mock-llm": "tsx scripts/mock-llm.ts",
    "loca": "node apps/cli/bin/loca.mjs",
    "ui-rules": "tsx scripts/ui-rules.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "tsx": "^4.23.15",
    "hono": "^4.13.13",
    "@hono/node-server": "^2.1.4"
  }
}
