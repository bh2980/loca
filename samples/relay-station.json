 "units": [
  {
   "key": "arrival.1",
   "group": "arrival",
   "speaker": "MIRA",
   "source": "The relay station is dark. Someone cut the power, {player}."
  },
  {
   "key": "arrival.2",
   "group": "arrival",
   "speaker": "JONAS",
   "source": "Or it's just old. Nothing out here lasts."
  },
  {
   "key": "arrival.3",
   "group": "arrival",
   "speaker": "MIRA",
   "source": "Check the <b>breaker panel</b>. I will watch the door."
  },
  {
   "key": "panel.1",
   "group": "panel",
   "speaker": "JONAS",
   "source": "The fuses are fine. This was switched off by hand."
  },
  {
   "key": "panel.2",
   "group": "panel",
   "speaker": "MIRA",
   "source": "Then they are still here."
  },
  {
   "key": "logbook.1",
   "group": "logbook",
   "speaker": "NARRATOR",
   "source": "A logbook lies open. The last entry is dated three days ago."
  },
  {
   "key": "logbook.2",
   "group": "logbook",
   "speaker": "MIRA",
   "source": "\"Signal from the north tower again. Ignoring orders.\""
  },
  {
   "key": "logbook.3",
   "group": "logbook",
   "speaker": "JONAS",
   "source": "Ignoring whose orders?"
  },
  {
   "key": "tower.1",
   "group": "tower",
   "speaker": "MIRA",
   "source": "The tower light is blinking. %d short, %d long."
  },
  {
   "key": "tower.2",
   "group": "tower",
   "speaker": "JONAS",
   "source": "That's not a fault. That's a code."
  },
  {
   "key": "tower.3",
   "group": "tower",
   "speaker": "MIRA",
   "source": "Write it down. Every pulse."
  },
  {
   "key": "ending.1",
   "group": "ending",
   "speaker": "NARRATOR",
   "source": "Dawn comes slowly over the ridge."
  },
  {
   "key": "ending.2",
   "group": "ending",
   "speaker": "JONAS",
   "source": "We tell the Directorate nothing.\nAgreed?"
  },
  {
   "key": "ending.3",
   "group": "ending",
   "speaker": "MIRA",
   "source": "Agreed."
  },
  {
